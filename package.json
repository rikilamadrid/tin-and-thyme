{
  "name": "tin-and-thyme",
  "version": "0.1.0",
  "private": true,
  "description": "Tin & Thyme — watch a Pathfinder orchestration run as a robot kitchen. One local command opens the board, the crew, their terminals and every human gate for the repository you are in.",
  "license": "MIT",
  "author": {
    "name": "Ricardo Lamadrid",
    "url": "https://github.com/rikilamadrid"
  },
  "type": "module",
  "homepage": "https://github.com/rikilamadrid/tin-and-thyme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikilamadrid/tin-and-thyme.git"
  },
  "bugs": {
    "url": "https://github.com/rikilamadrid/tin-and-thyme/issues"
  },
  "keywords": [
    "tin-and-thyme",
    "pathfinder",
    "wonder-wagon",
    "ai-agents",
    "agent-orchestration",
    "claude-code",
    "orchestrator",
    "pixel-art",
    "local-first",
    "developer-tools"
  ],
  "bin": {
    "tin-and-thyme": "bin/tin-and-thyme.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/tin-and-thyme.mjs",
    "dist",
    "dist-server",
    "scripts/fix-node-pty.mjs",
    "docs/images",
    "brand/readme",
    "LICENSE",
    "TRADEMARKS.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:hq": "concurrently -k -n hq,ui -c magenta,cyan \"tsx watch server/main.ts --dev\" \"vite\"",
    "hq": "vite build --logLevel warn && tsx server/main.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "build": "tsc --noEmit -p . && tsc --noEmit -p server && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "brand": "tsx scripts/brand/render-brand.ts",
    "prepack": "npm run build && node scripts/npm-readme.mjs pin",
    "postpack": "node scripts/npm-readme.mjs unpin",
    "prepublishOnly": "node scripts/publish-guard.mjs",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/headless": "5.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "framer-motion": "^11.18.2",
    "pixi.js": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "zustand": "^5.0.15"
  }
}
